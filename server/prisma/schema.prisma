generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//    ENUMS

enum Role {
  User
  Admin
}

enum Duration {
  Week
  Month
}

// MODELS

model Restaurant {
  id           Int         @id   @default(autoincrement())
  name         String
  slogan       String?
  thumbnail    String
  number       Int
  address      String
  email        String         @unique
  password     String
  users        User[]
  categories   Category[]
  orders       Order[]
  saleSummary  SaleSummary[]
  orderSummary OrderSummary[]
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  password          String
  name              String?
  number            Int
  canModify         Boolean    @default(false)
  role              Role       @default(User)
  restaurantId      Int
  verificationToken String     @unique
  isVerified        Boolean    @default(false)
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id])
}

model Category {
  id           String     @id @default(uuid())
  name         String
  restaurantId Int
  createdAt    String
  products     Product[]
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
}

model Product {
  id              String           @id @default(uuid())
  name            String
  thumbnail       String
  productVariants ProductVariant[]
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
}

model ProductVariant {
  id           String  @id @default(uuid())
  size         String
  price        Int
  isOutOfStock Boolean @default(false)
  sold         Int
  productId    String
  product      Product @relation(fields: [productId], references: [id])
}

model Order {
  id           String     @id @default(uuid())
  orders       String
  isDone       Boolean    @default(false)
  amount       Int
  isPaid       Boolean    @default(false)
  createdAt    String
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
}

model SaleSummary {
  id           String     @id @default(uuid())
  amount       Int
  duration     Duration
  cratedAt     String
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
}

model OrderSummary {
  id           String     @id @default(uuid())
  orders       Int
  increasedBy  Decimal
  duration     Duration
  createdAt    String
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
}
