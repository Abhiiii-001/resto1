generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//    ENUMS

enum Role {
  User
  Admin
  Restaurant
}

enum Duration {
  Day
  Week
  Month
}

enum Status {
  Ready
  Pending
  Cancelled
  Completed
}

enum PaymentOption {
  Online
  Cash
}

// MODELS

model Restaurant {
  id           String            @id @default(uuid())
  resCode      String
  name         String
  slogan       String?
  thumbnail    String
  number       String
  address      String
  email        String         @unique
  password     String
  role         Role           @default(Restaurant)
  users        User[]
  categories   Category[]
  orders       Order[]
  saleSummary  SaleSummary[]
  orderSummary OrderSummary[]
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  password          String
  name              String?
  number            String
  canModify         Boolean    @default(false)
  role              Role       @default(User)
  restaurantId      String
  verificationToken String     @unique
  isVerified        Boolean    @default(false)
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id],onDelete: Cascade)
}

model Category {
  id           String     @id @default(uuid())
  name         String     @unique
  thumbnail    String
  restaurantId String
  createdAt    String
  products     Product[]
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id],onDelete: Cascade)
}

model Product {
  id              String           @id @default(uuid())
  name            String
  description     String
  thumbnail       String
  sold            Int                @default(0)
  rating          Decimal?
  productVariants ProductVariant[]
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id],onDelete: Cascade)
}

model ProductVariant {
  id           String     @id @default(uuid())
  size         String
  price        Int
  salePrice    Int
  isOutOfStock Boolean    @default(false)
  productId    String
  product      Product    @relation(fields: [productId], references: [id],onDelete: Cascade)
  orders       subOrder[]
}

model Order {
  id           String     @id @default(uuid())
  orderCode    String
  name         String
  note         String?
  orders       subOrder[]
  status       Status     @default(Pending)
  amount       Int
  isPack       Boolean
  paymentOption PaymentOption
  createdAt    String
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id],onDelete: Cascade)
}

model subOrder {
  id               String         @id @default(uuid())
  productVariantId String
  quantity         Int
  unitPrice        Int
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id],onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
}

model SaleSummary {
  id           String     @id @default(uuid())
  amount       Int
  duration     Duration
  cratedAt     String
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id],onDelete: Cascade)
}

model OrderSummary {
  id           String     @id @default(uuid())
  orders       Int
  increasedBy  Decimal
  duration     Duration
  createdAt    String
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id],onDelete: Cascade)
}
