generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//    ENUMS

enum Role {
  User
  Admin
  Restaurant
}

enum Duration {
  Day
  Week
  Month
}

enum Status {
  Ready
  Pending
  Cancelled
  Completed
}

enum PaymentOption {
  Online
  Cash
}


// MODELS

model Restaurant {
  id                String         @id @default(uuid())
  resCode           String
  name              String
  slogan            String?
  thumbnail         String
  isOpen            Boolean        @default(false)
  number            String
  address           String
  email             String         @unique
  password          String
  verificationToken String         @unique
  isVerified        Boolean        @default(false)
  autoAcceptOrder   Boolean        @default(true)
  role              Role           @default(Restaurant)
  totalEarning      Int         @default(0)
  totalOrders       Int         @default(0)
  totalQRScan       Int         @default(0)
  isActive          Boolean     @default(true)
  users             User[]
  categories        Category[]
  orders            Order[]
  saleSummary       SaleSummary[]
  subscription      Subscription?
  payments          Payment[]
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  password          String
  name              String?
  number            String
  canModify         Boolean    @default(false)
  role              Role       @default(User)
  restaurantId      String
  verificationToken String     @unique
  isVerified        Boolean    @default(false)
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Category {
  id           String     @id @default(uuid())
  name         String     @unique
  thumbnail    String
  isActive     Boolean    @default(true)
  restaurantId String
  createdAt    String
  products     Product[]
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Product {
  id              String           @id @default(uuid())
  name            String
  description     String
  thumbnail       String
  isActive        Boolean          @default(true)
  rating          Decimal?
  productVariants ProductVariant[]
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id           String     @id @default(uuid())
  size         String
  price        Int
  salePrice    Int?
  sold         Int              @default(0)
  isOutOfStock Boolean    @default(false)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders       subOrder[]
}

model Order {
  id            String        @id @default(uuid())
  orderCode     String        @unique
  name          String?
  note          String?
  orders        subOrder[]
  status        Status        @default(Pending)
  amount        Int
  isPack        Boolean
  isVerified    Boolean       @default(false)
  subscription  String?
  invoice       String?
  paymentOption PaymentOption
  createdAt     String
  restaurantId  String
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  payments      Payment[]
}

model subOrder {
  id               String         @id @default(uuid())
  name             String
  variant          String
  productVariantId String
  quantity         Int
  unitPrice        Int
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
}

model SaleSummary {
  id           String     @id @default(uuid())
  amount       Int
  orders        Int
  duration     Duration
  createdAt    String
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Plan {
  id            String         @id @default(uuid())
  name          String         @unique
  type          Int                            // 1=DEMO, 2=PRO, 3=PREMIUM
  price         Int            @default(0)
  isDemo        Boolean        @default(false)
  maxProducts   Int            @default(-1)
  maxCategories Int            @default(-1)
  maxEmployees  Int            @default(-1)
  maxQRCodes    Int            @default(-1)
  orderHistory  Int            @default(-1)
  features      String[]
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(uuid())
  restaurantId       String             @unique
  planId             String
  status             Int                @default(1)    // 1=ACTIVE, 2=EXPIRED, 3=CANCELLED, 4=PAST_DUE
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  restaurant         Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id])
  payments           Payment[]
}

model Payment {
  id               String        @id @default(uuid())
  amount           Int
  currency         String        @default("INR")
  paymentType      Int                                  // 1=SUBSCRIPTION, 2=ORDER
  status           Int           @default(1)             // 1=PENDING, 2=CAPTURED, 3=FAILED, 4=REFUNDED
  gateway          String        @default("phonepe")   // "phonepe", "razorpay", "stripe" etc.
  gatewayPaymentId String?                              // Gateway transaction ID
  gatewayOrderId   String?                              // Gateway order/merchant txn ID
  invoiceUrl       String?
  metadata         Json?                                // Any extra gateway-specific data
  subscriptionId   String?                              // Linked if paymentType = SUBSCRIPTION
  orderId          String?                              // Linked if paymentType = ORDER
  restaurantId     String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  order            Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  restaurant       Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}
