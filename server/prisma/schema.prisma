generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//    ENUMS

enum Role {
  User
  Admin
  Restaurant
}

enum Duration {
  Day
  Week
  Month
}

enum Status {
  Ready
  Pending
  Cancelled
  Completed
}

enum PaymentOption {
  Online
  Cash
}

// MODELS

model Restaurant {
  id                String         @id @default(uuid())
  resCode           String
  name              String
  slogan            String?
  thumbnail         String
  isOpen            Boolean        @default(false)
  number            String
  address           String
  email             String         @unique
  password          String
  verificationToken String         @unique
  isVerified        Boolean        @default(false)
  autoAcceptOrder   Boolean        @default(true)
  role              Role           @default(Restaurant)
  totalEarning      Int         @default(0)
  totalOrders       Int         @default(0)
  totalQRScan       Int         @default(0)
  isActive          Boolean     @default(true)
  users             User[]
  categories        Category[]
  orders            Order[]
  saleSummary       SaleSummary[]
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  password          String
  name              String?
  number            String
  canModify         Boolean    @default(false)
  role              Role       @default(User)
  restaurantId      String
  verificationToken String     @unique
  isVerified        Boolean    @default(false)
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Category {
  id           String     @id @default(uuid())
  name         String     @unique
  thumbnail    String
  restaurantId String
  createdAt    String
  products     Product[]
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Product {
  id              String           @id @default(uuid())
  name            String
  description     String
  thumbnail       String
  rating          Decimal?
  productVariants ProductVariant[]
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id           String     @id @default(uuid())
  size         String
  price        Int
  salePrice    Int?
  sold         Int              @default(0)
  isOutOfStock Boolean    @default(false)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders       subOrder[]
}

model Order {
  id            String        @id @default(uuid())
  orderCode     String        @unique
  name          String?
  note          String?
  orders        subOrder[]
  status        Status        @default(Pending)
  amount        Int
  isPack        Boolean
  isVerified    Boolean       @default(false)
  subscription  String?
  invoice       String?
  paymentOption PaymentOption
  createdAt     String
  restaurantId  String
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model subOrder {
  id               String         @id @default(uuid())
  name             String
  variant          String
  productVariantId String
  quantity         Int
  unitPrice        Int
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
}

model SaleSummary {
  id           String     @id @default(uuid())
  amount       Int
  orders        Int
  duration     Duration
  createdAt    String
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

